DATABASE_URL=postgres://localhost:5432/deploydb
API_HOST=127.0.0.1
API_PORT=8097

# How many replicas the deployment targets
REPLICAS=3
POD_BASE_PORT=9200

# Rolling-update tuning
READINESS_TIMEOUT=8
READINESS_INTERVAL=0.3
SMOKE_ATTEMPTS=3

# Self-healing liveness monitor interval
LIVENESS_INTERVAL=2
